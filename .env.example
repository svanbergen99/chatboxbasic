# Development only
KCD_DEV_MODE=0
KCD_COOKIE_SECURE=0

# Public deployment
KCD_PUBLIC_ORIGIN=https://kcdchatbox.nl
KCD_SESSION_TTL=28800
KCD_HANDOFF_TTL=60

# IMPORTANT: set a long random value locally/on the server.
# Never commit the real value.
KCD_HANDOFF_SECRET=CHANGE_ME_LOCALLY

# Backends
AI_CORE_URL=http://127.0.0.1:8091/api/chat
DIVA_URL=http://127.0.0.1:8090/api/chat
CASEY_URL=
DEE_URL=

# Optional device allowlist, comma separated
CHATBOX_ALLOWED_DEVICES=
